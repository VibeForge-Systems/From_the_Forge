{
  "name": "openmessage-archive",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first desktop archive for iPhone Messages backups.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses": "node scripts/check-licenses.mjs",
    "tauri": "tauri",
    "icons": "tauri icon scripts/icon.svg -o src-tauri/icons && node scripts/prune-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "pinia": "3.0.4",
    "virtua": "0.53.1",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.13"
  }
}
