# Exact versions only; `npm install <pkg>` must not write a caret range.
save-exact=true
engine-strict=true
fund=false
# npm 10's arborist crashes resolving vitest 4's optional peer graph
# (TypeError: reading 'edgesOut' in #loadPeerSet). Every peer this project
# needs (vue, vite, typescript) is a direct dependency, so peers are not
# auto-installed. Revisit when CI moves to npm 11.
legacy-peer-deps=true
