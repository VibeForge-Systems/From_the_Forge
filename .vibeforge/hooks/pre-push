#!/usr/bin/env bash
#
# pre-push — run this repository's full merge bar before anything leaves the
# machine.
#
# This is the "you cannot push red" property, enforced locally. It runs every
# `stage: commit` and `stage: push` check declared in .vibeforge/gates.yaml.
#
# Install:  git config core.hooksPath .vibeforge/hooks
# Bypass:   git push --no-verify
#
# Prefer a narrower escape hatch over --no-verify when you can:
#   <SKIP_VAR>=1 git push          skip one declared-skippable check (gate.sh --list)
#   VF_GATE_ALLOW_SKIP=1 git push  accept a missing-tool gap for this push
#
# A non-zero exit refuses the push. Exit 2 means a check was SKIPPED rather than
# failed — the run is weaker than the bar this repository declares, so it stops
# you the same way a failure would.
#
# WHAT IS PUSHED, NOT WHAT IS CHECKED OUT. git hands this hook the refs being
# pushed on stdin ("<local ref> <local sha> <remote ref> <remote sha>" per
# line) and the remote's name as $1. The hook passes all of it to the runner
# (VF_PUSH_UPDATES, VF_PUSH_REMOTE, VF_PUSH_URL), which turns it into
# $VF_OUTGOING: every commit this push would publish. Without that, a gate
# sees only the working tree — and `git push origin topic` from main, or a
# secret added and deleted inside one push, sails through.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
updates="$(mktemp)"
trap 'rm -f "$updates"' EXIT
cat > "$updates"

echo "pre-push: running the local merge bar (.vibeforge/gate.sh) — bypass with 'git push --no-verify'"
rc=0
VF_PUSH_REMOTE="${1:-}" VF_PUSH_URL="${2:-}" VF_PUSH_UPDATES="$updates" \
  "$ROOT/.vibeforge/gate.sh" || rc=$?
exit "$rc"
