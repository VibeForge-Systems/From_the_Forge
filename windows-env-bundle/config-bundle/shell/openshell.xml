<?xml version="1.0"?>
<!--
  ==========================================================================
  VibeForge Systems - Windows Environment Bundle
  openshell.xml - Open-Shell (Classic Start Menu) settings

  A Windows 7-style Start menu with the Aero skin. Imported NON-INTERACTIVELY
  by apply-shell.ps1 via:

      StartMenu.exe -xml C:\ProgramData\VibeForge\openshell.xml

  Schema notes (verified against Open-Shell source, Src/Lib/Settings.cpp):
    - Root element MUST be <Settings component="StartMenu" ...>.
    - Each setting is <Name value="..."/> - the value is an ATTRIBUTE, and enum
      settings use the option NAME string (e.g. "Win7"), not a number.
    - Import is a FULL REPLACE: any setting not listed here is reset to default,
      so only list what you want to change.
    - Unknown/misspelled elements are silently ignored.

  Import gotchas (both enforced by apply-shell.ps1):
    - The XML path must be ABSOLUTE and contain NO SPACES - StartMenu.exe cuts
      the path at the first space, so "C:\Program Files\..." would be truncated.
    - The binary is StartMenu.exe (Open-Shell). ClassicStartMenu.exe was the old
      discontinued Classic Shell name and does not exist in Open-Shell.

  To customize: tune Open-Shell's Settings UI on a reference machine, then
  "Backup -> Save to XML file" (== StartMenu.exe -backup <path>) and replace
  this file with that export.

  TO REVERT: Open-Shell settings -> "Backup" -> "Reset all settings".
  ==========================================================================
-->
<Settings component="StartMenu" version="4.4.198">
  <!-- Win7 = the Windows 7-style two-column menu. Also valid: Classic1, Classic2. -->
  <MenuStyle value="Win7"/>
  <!-- Built-in Aero skin to match the classic look. -->
  <SkinW7 value="Windows Aero"/>
  <!-- Replace the Windows 11 Start button with the Open-Shell (Aero orb) button. -->
  <EnableStartButton value="1"/>
  <!-- Valid: AeroButton, ClasicButton (sic - one 's'), CustomButton. -->
  <StartButtonType value="AeroButton"/>
  <!-- Search box at the bottom of the menu. Valid: Hide, Normal, Tab. -->
  <SearchBox value="Normal"/>
  <!-- Show recently used programs. Valid: None, Recent, Frequent. -->
  <RecentPrograms value="Recent"/>
</Settings>
